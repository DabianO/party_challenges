# Copy to .env (never commit .env) and fill in. See docs/deployment.md.

# The address guests use, e.g. party.yourdomain.nl (no https://).
PARTY_HOST=party.example.nl

# From Cloudflare -> Networking -> Tunnels -> your tunnel: only the long token after --token.
TUNNEL_TOKEN=

# Asked when you create a game on http://localhost:3000/host. Make it long and random.
HOST_CREATE_PASSWORD=

# Port of the host controls on this laptop (http://localhost:3000/host). Change it when
# something else (e.g. `npm run dev`) already uses 3000.
# HOST_PORT=3000

# Only when a company network blocks the tunnel's default connection: http2
# TUNNEL_PROTOCOL=http2
