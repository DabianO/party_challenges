{
  "type": "object",
  "required": ["image"],
  "properties": {
    "image": { "type": "string", "format": "media-ref", "title": "Picture to caption" },
    "prompt": { "type": "string", "title": "Prompt", "default": "Write the funniest caption for this picture", "maxLength": 200 },
    "timeLimit": { "type": "integer", "title": "Time limit (seconds)", "minimum": 15, "maximum": 600, "default": 90 },
    "maxLength": { "type": "integer", "title": "Maximum caption length", "minimum": 20, "maximum": 280, "default": 120 },
    "points": { "type": "integer", "title": "Points for an approved caption", "minimum": 1, "maximum": 100, "default": 10 }
  }
}
