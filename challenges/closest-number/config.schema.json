{
  "type": "object",
  "required": ["question", "correctAnswer", "timeLimit"],
  "properties": {
    "question": { "type": "string", "title": "Question", "minLength": 1, "maxLength": 300 },
    "correctAnswer": { "type": "number", "title": "Correct answer" },
    "unit": { "type": "string", "title": "Unit", "default": "", "maxLength": 20 },
    "timeLimit": { "type": "integer", "title": "Time limit (seconds)", "maximum": 600, "default": 30, "anyOf": [{ "const": 0, "title": "No time limit" }, { "minimum": 5 }] },
    "maxPoints": { "type": "integer", "title": "Maximum points", "minimum": 1, "maximum": 1000, "default": 10 },
    "scoring": {
      "type": "string",
      "title": "Scoring",
      "description": "ranked: 1st closest gets max points, then decreasing. distance: points shrink with relative distance.",
      "enum": ["ranked", "distance"],
      "default": "ranked"
    },
    "media": { "type": "string", "format": "media-ref", "title": "Image (optional)" }
  }
}
