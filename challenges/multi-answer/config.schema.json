{
  "type": "object",
  "required": ["question", "answers"],
  "properties": {
    "question": { "type": "string", "title": "Question", "minLength": 1, "maxLength": 300 },
    "answers": {
      "type": "array",
      "title": "Answers",
      "description": "One answer, or up to 12 for a question with several (each correct one scores a share of the points). Label (optional): shown above the answer box, e.g. \"Capital of France\". Alternatives: other accepted spellings, separated by commas. A number as the answer gives players a number box; tolerance accepts anything within plus/minus that amount.",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["answer"],
        "properties": {
          "label": { "type": "string", "title": "Label", "maxLength": 100 },
          "answer": { "type": "string", "title": "Correct answer", "minLength": 1, "maxLength": 100 },
          "alternatives": { "type": "string", "title": "Alternatives", "maxLength": 300 },
          "tolerance": { "type": "number", "title": "± Tolerance", "minimum": 0 },
          "unit": { "type": "string", "title": "Unit", "maxLength": 20 }
        }
      }
    },
    "anyOrder": { "type": "boolean", "title": "Several answers may be given in any order", "default": false },
    "timeLimit": { "type": "integer", "title": "Time limit (seconds)", "maximum": 600, "default": 60, "anyOf": [{ "const": 0, "title": "No time limit" }, { "minimum": 5 }] },
    "points": { "type": "integer", "title": "Points for a fully correct answer", "minimum": 1, "maximum": 1000, "default": 10 },
    "media": { "type": "string", "format": "media-ref", "title": "Image (optional)" }
  }
}
